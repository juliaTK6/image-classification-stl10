    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "N6BK4YCPWxaN"
      },
      "outputs": [],
      "source": [
        "#分類クラス数\n",
        "num_classes = 10\n",
        "\n",
        "#ネットワーク定義\n",
        "class SampleNet(nn.Module):\n",
        "\n",
        "  def __init__(self, num_classes):\n",
        "    super(SampleNet, self).__init__()\n",
        "    self.features = nn.Sequential(\n",
        "      #チャンネル3->64, 高さ96x幅96->48x48 (カーネルサイズ3の畳み込み層)\n",
        "      nn.Conv2d(3, 64, kernel_size=3, stride=2, padding=1),\n",
        "      nn.ReLU(),\n",
        "      #チャンネル64->128, 高さ48x幅48->24x24 (カーネルサイズ3の畳み込み層)\n",
        "      nn.Conv2d(64, 128, kernel_size=3, stride=2, padding=1),\n",
        "      nn.ReLU(),\n",
        "      #高さ24x幅24->12x12 (プーリング層)\n",
        "      nn.MaxPool2d(kernel_size=2, stride=2),\n",
        "      #全パラメータの 30 % をゼロにする (ドロップアウト)\n",
        "      nn.Dropout( p=0.3 ),\n",
        "      #チャンネル128->256, 高さ12x幅12->6x6 (カーネルサイズ3の畳み込み層)\n",
        "      nn.Conv2d(128, 256, kernel_size=3, stride=2, padding=1),\n",
        "      nn.ReLU(),\n",
        "      #チャンネル256->512, 高さ6x幅6->3x3 (カーネルサイズ3の畳み込み層)\n",
        "      nn.Conv2d(256, 512, kernel_size=3, stride=2, padding=1),\n",
        "      nn.ReLU(),\n",
        "      #高さ3x幅3->2x2 (プーリング層)\n",
        "      nn.MaxPool2d(kernel_size=2, stride=1),\n",
        "      #全パラメータの 20 % をゼロにする (ドロップアウト)\n",
        "      #nn.Dropout( p=0.2 ),\n",
        "      #チャンネル512->1024, 高さ6x幅6->3x3 (カーネルサイズ3の畳み込み層)\n",
        "      #nn.Conv2d(512, 1024, kernel_size=3, stride=2, padding=1),\n",
        "      #nn.ReLU(),\n",
        "      #チャンネル1024->2048, 高さ12x幅12->12x12 (カーネルサイズ3の畳み込み層)\n",
        "      #nn.Conv2d(1024, 2048, kernel_size=3, stride=1, padding=1),\n",
        "      #nn.ReLU(),\n",
        "      #高さ12x幅12->6x6 (プーリング層)\n",
        "      #nn.MaxPool2d(kernel_size=2, stride=2),\n",
        "      #全パラメータの 30 % をゼロにする (ドロップアウト)\n",
        "      #nn.Dropout( p=0.3 ),\n",
        "      #チャンネル2048->4096, 高さ6x幅6->6x6 (カーネルサイズ3の畳み込み層)\n",
        "      #nn.Conv2d(2048, 4096, kernel_size=3, stride=2, padding=1),\n",
        "      #nn.ReLU(),\n",
        "      #チャンネル4096->8192, 高さ6x幅6->6x6 (カーネルサイズ3の畳み込み層)\n",
        "      #nn.Conv2d(4096, 8192, kernel_size=3, stride=1, padding=1),\n",
        "      #nn.ReLU(),\n",
        "      #高さ6x幅6->3x3 (プーリング層)\n",
        "      #nn.MaxPool2d(kernel_size=2, stride=2),\n",
        "      #全パラメータの 40 % をゼロにする (ドロップアウト)\n",
        "      #nn.Dropout( p=0.4 ),\n",
        "    )\n",
        "    self.classifier = nn.Sequential(\n",
        "      #全パラメータの 50 % をゼロにする (ドロップアウト)\n",
        "      nn.Dropout( p=0.5 ),\n",
        "      #512*2*2->認識クラス数 (全結合層)\n",
        "      nn.Linear(512*2*2, num_classes),\n",
        "    )\n",
        "\n",
        "  def forward(self, x):\n",
        "    x = self.features(x)\n",
        "    x = x.view(x.size(0), -1)\n",
        "    x = self.classifier(x)\n",
        "    return x"
      ]
    },
